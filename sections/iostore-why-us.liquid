{% comment %}
  iO STORE — ¿Por qué iO STORE? (4 pilares de confianza)
  Paleta: Azul #004FA3 · Gris #F2F2F7 · Negro #1D1D1F
{% endcomment %}
 
<style>
  .ios-why {
    background: #1D1D1F;
    padding: 90px 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
  }
 
  .ios-why__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 64px;
  }
 
  .ios-why__eyebrow {
    font-size: 12px;
    font-weight: 600;
    color: #004FA3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
 
  .ios-why__title {
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 800;
    color: #F2F2F7;
    margin: 0 0 14px;
    letter-spacing: -1.5px;
    line-height: 1.05;
  }
 
  .ios-why__title span {
    color: #004FA3;
  }
 
  .ios-why__subtitle {
    font-size: 17px;
    color: rgba(242,242,247,0.5);
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
 
  /* ---- Grid de pilares ---- */
  .ios-why__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
 
  .ios-why__card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s, border-color 0.3s, transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
  }
 
  .ios-why__card:hover {
    background: rgba(0,79,163,0.12);
    border-color: rgba(0,79,163,0.4);
    transform: translateY(-5px);
  }
 
  /* Línea azul top al hover */
  .ios-why__card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: #004FA3;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    border-radius: 20px 20px 0 0;
  }
 
  .ios-why__card:hover::before {
    transform: scaleX(1);
  }
 
  .ios-why__icon {
    font-size: 36px;
    margin-bottom: 20px;
    display: block;
  }
 
  .ios-why__card-title {
    font-size: 18px;
    font-weight: 700;
    color: #F2F2F7;
    margin: 0 0 10px;
    letter-spacing: -0.3px;
  }
 
  .ios-why__card-desc {
    font-size: 14px;
    color: rgba(242,242,247,0.5);
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
 
  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .ios-why__grid { grid-template-columns: repeat(2, 1fr); }
  }
 
  @media (max-width: 560px) {
    .ios-why { padding: 60px 16px; }
    .ios-why__grid { grid-template-columns: 1fr; gap: 12px; }
    .ios-why__card { padding: 28px 22px; }
  }
</style>
 
<section class="ios-why">
 
  <div class="ios-why__header">
    {% if section.settings.eyebrow != blank %}
      <p class="ios-why__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ios-why__title">{{ section.settings.title | replace: '[[', '<span>' | replace: ']]', '</span>' }}</h2>
    {% if section.settings.subtitle != blank %}
      <p class="ios-why__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
 
  <div class="ios-why__grid">
    {% for block in section.blocks %}
      {% if block.type == 'pilar' %}
        <div class="ios-why__card">
          {% if block.settings.icon != blank %}
            <span class="ios-why__icon">{{ block.settings.icon }}</span>
          {% endif %}
          <h3 class="ios-why__card-title">{{ block.settings.title }}</h3>
          <p class="ios-why__card-desc">{{ block.settings.desc }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
 
</section>
 
{% schema %}
{
  "name": "iO Por que elegirnos",
  "tag": "section",
  "class": "section-ios-why",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "NUESTRA DIFERENCIA" },
    { "type": "text", "id": "title", "label": "Título (usa [[texto]] para azul)", "default": "¿Por qué [[iO STORE?]]" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Compramos Apple con la tranquilidad de saber que estás en buenas manos." }
  ],
  "blocks": [
    {
      "type": "pilar",
      "name": "Pilar",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ícono (emoji)", "default": "✓" },
        { "type": "text", "id": "title", "label": "Título", "default": "Original certificado" },
        { "type": "textarea", "id": "desc", "label": "Descripción", "default": "Todos nuestros equipos son sellados de fábrica con número de serie verificable en Apple.com." }
      ]
    }
  ],
  "presets": [
    {
      "name": "iO Por que elegirnos",
      "blocks": [
        {
          "type": "pilar",
          "settings": {
            "icon": "🔒",
            "title": "Original certificado",
            "desc": "Todos nuestros equipos son sellados de fábrica con número de serie verificable en Apple.com."
          }
        },
        {
          "type": "pilar",
          "settings": {
            "icon": "💰",
            "title": "Precio justo",
            "desc": "Sin intermediarios innecesarios. El mejor precio del mercado peruano con garantía incluida."
          }
        },
        {
          "type": "pilar",
          "settings": {
            "icon": "💬",
            "title": "Asesoría real",
            "desc": "Te ayudamos a elegir el equipo perfecto según tu presupuesto y necesidades, sin presionarte."
          }
        },
        {
          "type": "pilar",
          "settings": {
            "icon": "📦",
            "title": "Envío protegido",
            "desc": "Empaque seguro con número de tracking. Enviamos a todo el Perú con total seguridad."
          }
        }
      ]
    }
  ]
}
{% endschema %}