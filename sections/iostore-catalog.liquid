{% comment %}
  iO STORE — Catálogo de Productos con filtros por categoría
  Paleta: Azul #004FA3 · Gris #F2F2F7 · Negro #1D1D1F
{% endcomment %}
 
<style>
  .ios-cat {
    background: #F2F2F7;
    padding: 90px 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
  }
 
  /* ---- Header ---- */
  .ios-cat__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }
 
  .ios-cat__eyebrow {
    font-size: 12px;
    font-weight: 600;
    color: #004FA3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
 
  .ios-cat__title {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 800;
    color: #1D1D1F;
    margin: 0 0 14px;
    letter-spacing: -1px;
    line-height: 1.05;
  }
 
  .ios-cat__title span { color: #004FA3; }
 
  .ios-cat__subtitle {
    font-size: 17px;
    color: #6e6e73;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
 
  /* ---- Tabs ---- */
  .ios-cat__tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
 
  .ios-cat__tab {
    padding: 9px 22px;
    border-radius: 100px;
    border: 1.5px solid rgba(0,0,0,0.12);
    background: #fff;
    color: #1D1D1F;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
 
  .ios-cat__tab:hover {
    border-color: #004FA3;
    color: #004FA3;
  }
 
  .ios-cat__tab.active {
    background: #004FA3;
    color: #fff;
    border-color: #004FA3;
  }
 
  /* ---- Grid ---- */
  .ios-cat__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
 
  /* ---- Card ---- */
  .ios-cat__card {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.08);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
 
  .ios-cat__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.10);
  }
 
  .ios-cat__card[style*="display: none"] { display: none !important; }
 
  .ios-cat__card-img {
    background: #fff;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 220px;
    padding: 24px;
    position: relative;
  }
 
  .ios-cat__card-img img {
    max-height: 175px;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), opacity 0.2s ease;
  }
 
  .ios-cat__card:hover .ios-cat__card-img img {
    transform: scale(1.06) translateY(-4px);
  }
 
  .ios-cat__card-body {
    padding: 16px 16px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
 
  .ios-cat__card-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #004FA3;
    margin-bottom: 4px;
  }
 
  .ios-cat__card-title {
    font-size: 15px;
    font-weight: 700;
    color: #1D1D1F;
    margin: 0 0 10px;
    line-height: 1.3;
    letter-spacing: -0.2px;
  }
 
  /* Color label */
  .ios-cat__color-label {
    font-size: 12px;
    color: #6e6e73;
    margin-bottom: 6px;
  }
 
  .ios-cat__color-label strong {
    color: #1D1D1F;
    font-weight: 600;
  }
 
  /* Swatches — botones rectangulares estilo iShop */
  .ios-cat__swatches {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
 
  .ios-cat__swatch {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1.5px solid rgba(0,0,0,0.12);
    background: #fff;
    flex-shrink: 0;
    cursor: pointer;
    transition: border-color 0.15s ease;
    outline: none;
    padding: 0;
  }
 
  .ios-cat__swatch-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    display: block;
    flex-shrink: 0;
  }
 
  .ios-cat__swatch:hover {
    border-color: #004FA3;
  }
 
  .ios-cat__swatch.active {
    border-color: #004FA3;
    border-width: 2px;
    box-shadow: 0 0 0 1px #004FA3;
  }
 
  /* Garantía badge */
  .ios-cat__warranty {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    font-weight: 600;
    color: #34C759;
    margin-bottom: 8px;
  }
 
  .ios-cat__warranty svg {
    width: 11px;
    height: 11px;
    fill: #34C759;
  }

  /* Insignia verde sobre la imagen */
  .ios-cat__flag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #1E8E3E;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(30,142,62,0.28);
  }

  .ios-cat__flag svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Beneficios de compra */
  .ios-cat__perks {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 12px;
  }

  .ios-cat__perk {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: #E9F6EC;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    color: #1E8E3E;
    white-space: nowrap;
  }

  .ios-cat__perk svg {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    fill: none;
    stroke: #1E8E3E;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
 
  /* Precio + botón */
  .ios-cat__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }
 
  .ios-cat__price-wrap { display: flex; flex-direction: column; gap: 2px; }
 
  .ios-cat__price {
    font-size: 20px;
    font-weight: 800;
    color: #1D1D1F;
    letter-spacing: -0.5px;
  }
 
  .ios-cat__compare {
    font-size: 13px;
    color: #6e6e73;
    text-decoration: line-through;
  }
 
  .ios-cat__btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #004FA3;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
    text-decoration: none;
    flex-shrink: 0;
  }
 
  .ios-cat__btn:hover {
    background: #003A7A;
    transform: scale(1.08);
  }
 
  .ios-cat__btn svg {
    width: 16px;
    height: 16px;
    stroke: #fff;
    stroke-width: 2.5;
    fill: none;
  }
 
  /* Empty state */
  .ios-cat__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: #6e6e73;
    font-size: 16px;
    display: none;
  }
 
  .ios-cat__empty.visible { display: block; }
 
  /* ---- Responsive ---- */
  @media (max-width: 1100px) {
    .ios-cat__grid { grid-template-columns: repeat(3, 1fr); }
  }
 
  @media (max-width: 780px) {
    .ios-cat__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
 
  @media (max-width: 480px) {
    .ios-cat { padding: 60px 16px; }
    .ios-cat__grid { grid-template-columns: 1fr; }
    .ios-cat__tabs { gap: 6px; }
    .ios-cat__tab { padding: 8px 16px; font-size: 13px; }
  }
</style>
 
<section class="ios-cat">
 
  <div class="ios-cat__header">
    {% if section.settings.eyebrow != blank %}
      <p class="ios-cat__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ios-cat__title">{{ section.settings.title | replace: '[[', '<span>' | replace: ']]', '</span>' }}</h2>
    {% if section.settings.subtitle != blank %}
      <p class="ios-cat__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
 
  <!-- Tabs de filtro -->
  <div class="ios-cat__tabs">
    <button class="ios-cat__tab active" data-filter="all">Todos</button>
    {% for block in section.blocks %}
      {% if block.type == 'filter_tab' %}
        <button class="ios-cat__tab" data-filter="{{ block.settings.collection_handle }}">{{ block.settings.label }}</button>
      {% endif %}
    {% endfor %}
  </div>
 
  <!-- Grid de productos -->
  <div class="ios-cat__grid" id="ios-cat-grid">
 
    {% assign all_handles = '' %}
    {% for block in section.blocks %}
      {% if block.type == 'filter_tab' %}
        {% assign all_handles = all_handles | append: block.settings.collection_handle | append: ',' %}
      {% endif %}
    {% endfor %}
 
    {% assign handles_array = all_handles | split: ',' %}
 
    {% for handle in handles_array %}
      {% unless handle == blank %}
        {% assign col = collections[handle] %}
        {% if col != blank %}
          {% for product in col.products limit: 20 %}
            {% assign compare = product.compare_at_price_max %}
            <div class="ios-cat__card" data-category="{{ handle }}">
 
              <div class="ios-cat__card-img">

                {% if section.settings.perk1_show %}
                  <span class="ios-cat__flag">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M1 16V5.5A1.5 1.5 0 0 1 2.5 4h10A1.5 1.5 0 0 1 14 5.5V16"/>
                      <path d="M14 8h3.6a2 2 0 0 1 1.7.9L22 13v3h-8"/>
                      <circle cx="6" cy="18" r="2"/>
                      <circle cx="18" cy="18" r="2"/>
                    </svg>
                    {{ section.settings.perk1_text }}
                  </span>
                {% endif %}

                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title }}" loading="lazy" width="500">
                {% else %}
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#d1d1d6" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                {% endif %}
              </div>
 
              <div class="ios-cat__card-body">
 
                <p class="ios-cat__card-badge">
                  {{ col.title }}
                </p>
 
                <h3 class="ios-cat__card-title">{{ product.title }}</h3>
 
                {% assign color_opt_index = 0 %}
                {% for opt in product.options %}
                  {% assign opt_down = opt | downcase %}
                  {% if opt_down == 'color' or opt_down == 'colour' or opt_down == 'color' %}
                    {% assign color_opt_index = forloop.index %}
                  {% endif %}
                {% endfor %}
                {% assign has_colors = false %}
                {% if color_opt_index > 0 %}{% assign has_colors = true %}{% endif %}
                {% if has_colors %}
                  {% if color_opt_index == 1 %}{% assign first_color = product.variants.first.option1 %}{% elsif color_opt_index == 2 %}{% assign first_color = product.variants.first.option2 %}{% else %}{% assign first_color = product.variants.first.option3 %}{% endif %}
                  <p class="ios-cat__color-label">Color: <strong>{{ first_color }}</strong></p>
                  <div class="ios-cat__swatches">
                    {% assign seen_colors = '' %}
                    {% for variant in product.variants %}
                      {% if color_opt_index == 1 %}{% assign color_val = variant.option1 %}{% elsif color_opt_index == 2 %}{% assign color_val = variant.option2 %}{% else %}{% assign color_val = variant.option3 %}{% endif %}
                      {% unless seen_colors contains color_val %}
                        {% assign seen_colors = seen_colors | append: color_val | append: '|' %}
                        {% assign swatch_color = '#888' %}
                        {% case color_val %}
                          {% when 'Lavanda' %}{% assign swatch_color = '#E6E6FA' %}
                          {% when 'Blanco' %}{% assign swatch_color = '#F5F5F7' %}
                          {% when 'Blanco Estelar' %}{% assign swatch_color = '#F0EDE6' %}
                          {% when 'Sage' %}{% assign swatch_color = '#B2AC88' %}
                          {% when 'Sabio' %}{% assign swatch_color = '#B2AC88' %}
                          {% when 'Mist blue' %}{% assign swatch_color = '#C4D4DF' %}
                          {% when 'Azul niebla' %}{% assign swatch_color = '#C4D4DF' %}
                          {% when 'Azul Cielo' %}{% assign swatch_color = '#8BBDD9' %}
                          {% when 'Negro' %}{% assign swatch_color = '#1C1C1E' %}
                          {% when 'negro' %}{% assign swatch_color = '#1C1C1E' %}
                          {% when 'Negro Espacial' %}{% assign swatch_color = '#1C1C1E' %}
                          {% when 'Medianoche' %}{% assign swatch_color = '#1D2230' %}
                          {% when 'Plata' %}{% assign swatch_color = '#E0DFDB' %}
                          {% when 'Azul' %}{% assign swatch_color = '#004FA3' %}
                          {% when 'Naranja' %}{% assign swatch_color = '#FF6B00' %}
                          {% when 'Plateado' %}{% assign swatch_color = '#C0C5CE' %}
                          {% when 'Gris Espacial' %}{% assign swatch_color = '#5A5A5F' %}
                          {% when 'Negro Azabache' %}{% assign swatch_color = '#1C1C1E' %}
                          {% when 'Azabache negro' %}{% assign swatch_color = '#1C1C1E' %}
                          {% when 'Oro Rosa' %}{% assign swatch_color = '#E8C4B8' %}
                          {% when 'Morado' %}{% assign swatch_color = '#B8A9C9' %}
                          {% when 'Negro espacial' %}{% assign swatch_color = '#1C1C1E' %}
                          {% when 'Azul' %}{% assign swatch_color = '#5BBCD8' %}
                          {% when 'Púrpura' %}{% assign swatch_color = '#B8A9C9' %}
                          {% when 'Titanio Negro' %}{% assign swatch_color = '#2C2C2E' %}
                          {% when 'Titanio Natural' %}{% assign swatch_color = '#C8C0B4' %}
                          {% when 'Titanio Blanco' %}{% assign swatch_color = '#F0EDE6' %}
                          {% when 'Verde' %}{% assign swatch_color = '#4A6741' %}
                          {% when 'Amarillo' %}{% assign swatch_color = '#F5E642' %}
                          {% when 'Rosa' %}{% assign swatch_color = '#F2B8C6' %}
                          {% when 'Rojo' %}{% assign swatch_color = '#FF3B30' %}
                        {% endcase %}
                        {% assign variant_img_url = '' %}
                        {% if variant.image %}{% assign variant_img_url = variant.image | image_url: width: 500 %}{% endif %}
                        <button class="ios-cat__swatch" title="{{ color_val }}" data-color="{{ color_val }}" data-img="{{ variant_img_url }}" aria-label="{{ color_val }}">
                          <span class="ios-cat__swatch-dot" style="background: {{ swatch_color }};"></span>
                        </button>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}
 
                <p class="ios-cat__warranty">
                  <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Garantía Apple 1 año
                </p>

                {% if section.settings.perk2_show or section.settings.perk3_show %}
                  <div class="ios-cat__perks">
                    {% if section.settings.perk2_show %}
                      <span class="ios-cat__perk">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="12" r="9"/>
                          <path d="M12 7v5l3.5 2"/>
                        </svg>
                        {{ section.settings.perk2_text }}
                      </span>
                    {% endif %}
                    {% if section.settings.perk3_show %}
                      <span class="ios-cat__perk">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M3.5 9 5 4h14l1.5 5"/>
                          <path d="M4.5 9v11h15V9"/>
                          <path d="M9.5 20v-6h5v6"/>
                        </svg>
                        {{ section.settings.perk3_text }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
 
                <div class="ios-cat__footer">
                  <div class="ios-cat__price-wrap">
                    {% if compare > product.price_min %}
                      <span class="ios-cat__compare">S/. {{ compare | money_without_currency }}</span>
                    {% endif %}
                    <span class="ios-cat__price">S/. {{ product.price_min | money_without_currency }}</span>
                  </div>
                  <a href="{{ product.url }}" class="ios-cat__btn" aria-label="Ver {{ product.title }}">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
 
              </div>
            </div>
          {% endfor %}
        {% endif %}
      {% endunless %}
    {% endfor %}
 
    <div class="ios-cat__empty" id="ios-cat-empty">No hay productos en esta categoría.</div>
 
  </div>
 
</section>
 
<script>
(function() {
  // --- Filtro por tabs ---
  var tabs = document.querySelectorAll('.ios-cat__tab');
  var cards = document.querySelectorAll('.ios-cat__card');
  var empty = document.getElementById('ios-cat-empty');
 
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var filter = this.getAttribute('data-filter');
      tabs.forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      var visible = 0;
      cards.forEach(function(card) {
        var cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      if (empty) empty.classList.toggle('visible', visible === 0);
    });
  });
 
  // --- Swatches interactivos: borde azul + label de color + cambio de imagen ---
  document.querySelectorAll('.ios-cat__card').forEach(function(card) {
    var swatches = card.querySelectorAll('.ios-cat__swatch');
    var img = card.querySelector('.ios-cat__card-img img');
    var colorLabel = card.querySelector('.ios-cat__color-label strong');
    if (!swatches.length) return;
 
    // Activar primer swatch por defecto
    if (swatches[0]) swatches[0].classList.add('active');
 
    swatches.forEach(function(swatch) {
      swatch.addEventListener('click', function() {
        swatches.forEach(function(s) { s.classList.remove('active'); });
        this.classList.add('active');
 
        // Actualizar label de color
        var colorName = this.getAttribute('data-color');
        if (colorLabel && colorName) colorLabel.textContent = colorName;
 
        // Cambiar imagen si hay src de variante disponible
        var variantImg = this.getAttribute('data-img');
        if (variantImg && img) {
          img.style.opacity = '0';
          setTimeout(function() {
            img.src = variantImg;
            img.style.opacity = '1';
          }, 180);
        }
      });
    });
  });
})();
</script>
 
{% schema %}
{
  "name": "iO Catalogo",
  "tag": "section",
  "class": "section-ios-catalog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "iO STORE" },
    { "type": "text", "id": "title", "label": "Título (usa [[texto]] para azul)", "default": "[[Nuestros Productos]]" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Equipos Apple originales, sellados de fábrica con garantía oficial en Perú." },
    { "type": "header", "content": "Beneficios en las tarjetas" },
    { "type": "checkbox", "id": "perk1_show", "label": "Mostrar insignia verde sobre la imagen", "default": true },
    { "type": "text", "id": "perk1_text", "label": "Texto de la insignia sobre la imagen", "default": "Envío gratis" },
    { "type": "checkbox", "id": "perk2_show", "label": "Mostrar beneficio 1 bajo la garantía", "default": true },
    { "type": "text", "id": "perk2_text", "label": "Texto beneficio 2", "default": "Envío en 180 minutos" },
    { "type": "checkbox", "id": "perk3_show", "label": "Mostrar beneficio 2 bajo la garantía", "default": true },
    { "type": "text", "id": "perk3_text", "label": "Texto beneficio 3", "default": "Retira hoy" }
  ],
  "blocks": [
    {
      "type": "filter_tab",
      "name": "Tab de categoría",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre del tab", "default": "iPhones" },
        { "type": "text", "id": "collection_handle", "label": "Handle de la colección", "default": "iphones" }
      ]
    }
  ],
  "presets": [
    {
      "name": "iO Catalogo",
      "blocks": [
        { "type": "filter_tab", "settings": { "label": "iPhones", "collection_handle": "iphone" } },
        { "type": "filter_tab", "settings": { "label": "MacBooks", "collection_handle": "macbooks" } },
        { "type": "filter_tab", "settings": { "label": "iPads", "collection_handle": "ipads" } },
        { "type": "filter_tab", "settings": { "label": "AirPods", "collection_handle": "airpods" } },
        { "type": "filter_tab", "settings": { "label": "Apple Watch", "collection_handle": "apple-watch" } },
        { "type": "filter_tab", "settings": { "label": "Accesorios", "collection_handle": "accesorios" } }
      ]
    }
  ]
}
{% endschema %}