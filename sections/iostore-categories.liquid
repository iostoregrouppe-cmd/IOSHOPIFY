<style>
  .ios-cats {
    background: #f5f5f7;
    padding: 80px 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
  }
  .ios-cats__header { text-align: center; max-width: 640px; margin: 0 auto 52px; }
  .ios-cats__title { font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #1d1d1f; margin: 0 0 14px; letter-spacing: -0.5px; }
  .ios-cats__subtitle { font-size: 17px; color: #6e6e73; line-height: 1.6; margin: 0; }
  .ios-cats__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .ios-cats__card { background: #fff; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; justify-content: space-between; min-height: 280px; text-decoration: none; color: inherit; position: relative; overflow: hidden; transition: transform 0.25s ease, box-shadow 0.25s ease; cursor: pointer; }
  .ios-cats__card:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(0,0,0,0.1); text-decoration: none; color: inherit; }
  .ios-cats__card-arrow { position: absolute; top: 24px; right: 24px; width: 36px; height: 36px; background: #f5f5f7; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.2s, transform 0.2s; }
  .ios-cats__card:hover .ios-cats__card-arrow { background: #e5e5ea; transform: translate(2px, -2px); }
  .ios-cats__card-arrow svg { width: 14px; height: 14px; color: #1d1d1f; }
  .ios-cats__card-image { flex: 1; display: flex; align-items: center; justify-content: center; margin: 8px 0 20px; }
  .ios-cats__card-image img { max-height: 130px; max-width: 100%; object-fit: contain; transition: transform 0.3s ease; }
  .ios-cats__card:hover .ios-cats__card-image img { transform: scale(1.04); }
  .ios-cats__card-tagline { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
  .ios-cats__card-name { font-size: 24px; font-weight: 800; color: #1d1d1f; margin: 0 0 4px; letter-spacing: -0.3px; }
  .ios-cats__card-desc { font-size: 13px; color: #6e6e73; margin: 0; line-height: 1.4; }
  @media (max-width: 900px) { .ios-cats__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) {
    .ios-cats { padding: 60px 16px; }
    .ios-cats__grid { grid-template-columns: 1fr; gap: 14px; }
    .ios-cats__card { min-height: 200px; padding: 24px; flex-direction: row; align-items: center; gap: 20px; }
    .ios-cats__card-image { margin: 0; flex: 0 0 80px; }
    .ios-cats__card-image img { max-height: 80px; }
  }
</style>

<section class="ios-cats">
  {% if section.settings.title != blank or section.settings.subtitle != blank %}
    <div class="ios-cats__header">
      {% if section.settings.title != blank %}<h2 class="ios-cats__title">{{ section.settings.title }}</h2>{% endif %}
      {% if section.settings.subtitle != blank %}<p class="ios-cats__subtitle">{{ section.settings.subtitle }}</p>{% endif %}
    </div>
  {% endif %}
  <div class="ios-cats__grid">
    {% for block in section.blocks %}
      {% if block.type == 'category_card' %}
        <a href="{{ block.settings.card_url }}" class="ios-cats__card">
          <div class="ios-cats__card-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
          </div>
          <div class="ios-cats__card-image">
            {% if block.settings.card_image != blank %}
              <img src="{{ block.settings.card_image | image_url: width: 400 }}" alt="{{ block.settings.card_name }}" loading="lazy" width="400">
            {% endif %}
          </div>
          <div>
            {% if block.settings.card_tagline != blank %}<p class="ios-cats__card-tagline" style="color: {{ block.settings.tagline_color }}">{{ block.settings.card_tagline }}</p>{% endif %}
            <h3 class="ios-cats__card-name">{{ block.settings.card_name }}</h3>
            {% if block.settings.card_desc != blank %}<p class="ios-cats__card-desc">{{ block.settings.card_desc }}</p>{% endif %}
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "iO Categorías Grid",
  "tag": "section",
  "class": "section-ios-categories",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Explora por Categoría" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Equipos Apple originales con garantía oficial en Perú." }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Tarjeta de Categoría",
      "settings": [
        { "type": "image_picker", "id": "card_image", "label": "Imagen" },
        { "type": "text", "id": "card_tagline", "label": "Tagline", "default": "PODER EN TUS MANOS" },
        { "type": "color", "id": "tagline_color", "label": "Color del tagline", "default": "#3b82f6" },
        { "type": "text", "id": "card_name", "label": "Nombre", "default": "iPhone" },
        { "type": "text", "id": "card_desc", "label": "Descripción", "default": "Modelos nuevos y de última generación" },
        { "type": "url", "id": "card_url", "label": "URL de la colección" }
      ]
    }
  ],
  "presets": [
    {
      "name": "iO Categorías Grid",
      "blocks": [
        { "type": "category_card", "settings": { "card_tagline": "PODER EN TUS MANOS", "tagline_color": "#3b82f6", "card_name": "iPhone", "card_desc": "Modelos nuevos y de última generación" } },
        { "type": "category_card", "settings": { "card_tagline": "RENDIMIENTO PROFESIONAL", "tagline_color": "#8b5cf6", "card_name": "MacBook", "card_desc": "Procesadores M4 y alto rendimiento" } },
        { "type": "category_card", "settings": { "card_tagline": "CREATIVIDAD ILIMITADA", "tagline_color": "#06b6d4", "card_name": "iPad", "card_desc": "Pro, Air y Mini listos para diseñar" } },
        { "type": "category_card", "settings": { "card_tagline": "SONIDO DE ESTUDIO", "tagline_color": "#f59e0b", "card_name": "AirPods", "card_desc": "Cancelación activa y audio inmersivo" } },
        { "type": "category_card", "settings": { "card_tagline": "TU SALUD AL DÍA", "tagline_color": "#ec4899", "card_name": "Apple Watch", "card_desc": "Seguimiento inteligente y estilo" } },
        { "type": "category_card", "settings": { "card_tagline": "ORIGINALES GARANTIZADOS", "tagline_color": "#f97316", "card_name": "Accesorios", "card_desc": "Cargadores, fundas y MagSafe" } }
      ]
    }
  ]
}
{% endschema %}